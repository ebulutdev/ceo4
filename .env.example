# ============================================================================
# İLETİŞİM FORMU E-POSTA AYARLARI (/api/contact)
# ============================================================================
# Bu dosyayı ".env" adıyla kopyalayıp aşağıdaki iki yöntemden BİRİNİ doldurun.
#
# Nasıl çalışır? (Gönderen Adı + Reply-To Tekniği):
# - Gönderen (From): "Ahmet Yılmaz (Web Formu)" <form@fetsangrup.com>
# - Yanıtla (Reply-To): "Ahmet Yılmaz" <ahmet@gmail.com> (Kullanıcının yazdığı mail!)
# - Alıcı (To):
#     * İş Birliği & Yatırım -> umitfettahoglu@fetsangrup.com
#     * Genel & Basın        -> info@fetsangrup.com
# ============================================================================

# --- YÖNTEM 1 (ÖNERİLEN): RESEND API ---
# fetsangrup.com DNS'i Cloudflare'de; Resend alan adını Cloudflare'e tek tıkla doğrular.
# MAIL_FROM, Resend'de doğrulanmış alan adından olmalıdır.
RESEND_API_KEY=re_xxxxxxxxx
MAIL_FROM=form@fetsangrup.com

# --- YÖNTEM 2: MICROSOFT 365 SMTP (fetsangrup.com e-postası Microsoft 365'te) ---
# Not: "mail.fetsangrup.com" Cloudflare'e yönlenir, SMTP için ÇALIŞMAZ.
# Kullanılacak posta kutusunda M365 yönetim panelinden "Authenticated SMTP" açık olmalı;
# Microsoft şifreyle SMTP girişini kademeli olarak kapattığı için uzun vadede önerilmez.
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=iletisim@fetsangrup.com
# SMTP_PASS=posta_kutusu_sifresi
# MAIL_FROM=iletisim@fetsangrup.com

# --- ALICI ADRESLERİ (Varsayılan değerler) ---
MAIL_TO_EXEC=umitfettahoglu@fetsangrup.com
MAIL_TO_INFO=info@fetsangrup.com
